{
  "manifest_version": 3,
  "name": "AI Chat Persian RTL Fix",
  "version": "1.6.0",
  "description": "بهبود جهت متن فارسی و انگلیسی در رابط وب Claude، ChatGPT، Gemini، NotebookLM و Qwen Chat",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://notebooklm.google.com/*",
        "https://chat.qwen.ai/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "متن فارسی، مرتب‌تر"
  },
  "permissions": [
    "activeTab"
  ]
}
